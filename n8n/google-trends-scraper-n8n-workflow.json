    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ ($json.keyword + '_' + ($json.date || $json.geo || $json.related_keyword || $itemIndex)) }}",
        "options": {}
      },
      "id": "933250d6-94cc-5ad1-b972-024fc2fa0838",
      "name": "3. Skip Seen Records",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        720,
        220
